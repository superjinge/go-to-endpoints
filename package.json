{
  "name": "go-to-endpoints",
  "displayName": "%package.displayName%",
  "description": "%package.description%",
  "version": "0.0.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/superjinge/go-to-endpoints"
  },
  "icon": "resources/icons/icon.png",
  "publisher": "superjinge",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java",
    "workspaceContains:**/*.java"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gotoEndpoints.search",
        "title": "%command.search%"
      },
      {
        "command": "gotoEndpoints.scanCurrentFile",
        "title": "%command.scanCurrentFile%"
      },
      {
        "command": "gotoEndpoints.scanWorkspace",
        "title": "%command.scanWorkspace%",
        "icon": "$(refresh)"
      },
      {
        "command": "gotoEndpoints.refreshEndpointTree",
        "title": "%command.refreshTree%",
        "icon": "$(refresh)"
      },
      {
        "command": "gotoEndpoints.openEndpoint",
        "title": "%command.openEndpoint%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "endpoint-explorer",
          "title": "%viewContainer.endpointExplorer%",
          "icon": "resources/icons/endpoint.svg"
        }
      ]
    },
    "views": {
      "endpoint-explorer": [
        {
          "id": "gotoEndpointsExplorer",
          "name": "%view.explorer.name%",
          "icon": "resources/icons/endpoint.svg",
          "contextualTitle": "%view.explorer.contextual%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gotoEndpoints.refreshEndpointTree",
          "when": "view == gotoEndpointsExplorer",
          "group": "navigation"
        },
        {
          "command": "gotoEndpoints.scanWorkspace",
          "when": "view == gotoEndpointsExplorer",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "gotoEndpoints.scanCurrentFile",
          "when": "resourceLangId == java",
          "group": "1_gotoEndpoints"
        },
        {
          "command": "gotoEndpoints.scanWorkspace",
          "group": "1_gotoEndpoints"
        }
      ],
      "explorer/context": [
        {
          "command": "gotoEndpoints.scanCurrentFile",
          "when": "resourceLangId == java",
          "group": "1_gotoEndpoints"
        },
        {
          "command": "gotoEndpoints.scanWorkspace",
          "group": "1_gotoEndpoints"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gotoEndpoints.search",
        "key": "ctrl+shift+\\",
        "mac": "cmd+shift+\\"
      },
      {
        "command": "gotoEndpoints.scanCurrentFile",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j"
      },
      {
        "command": "gotoEndpoints.scanWorkspace",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "gotoEndpoints.displayLanguage": {
          "type": "string",
          "enum": [
            "en",
            "zh-cn"
          ],
          "default": "en",
          "description": "%config.displayLanguage%",
          "enumDescriptions": [
            "%config.displayLanguage.en%",
            "%config.displayLanguage.zhCn%"
          ]
        },
        "gotoEndpoints.includeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.java"
          ],
          "description": "%config.includeGlobs%"
        },
        "gotoEndpoints.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/target/**",
            "**/build/**",
            "**/.*/**",
            "**/*Test.java"
          ],
          "description": "%config.excludeGlobs%"
        },
        "gotoEndpoints.enableCache": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableCache%"
        },
        "gotoEndpoints.concurrencyLimit": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 200,
          "description": "%config.concurrencyLimit%"
        },
        "gotoEndpoints.autoIndex": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoIndex%"
        },
        "gotoEndpoints.usePrefilter": {
          "type": "boolean",
          "default": true,
          "description": "%config.usePrefilter%"
        },
        "gotoEndpoints.fileExtensions": {
          "type": "array",
          "default": [
            ".java"
          ],
          "description": "%config.fileExtensions%"
        },
        "gotoEndpoints.enableDecorations": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableDecorations%"
        },
        "gotoEndpoints.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableCodeLens%"
        },
        "gotoEndpoints.notificationTimeout": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "maximum": 10000,
          "description": "%config.notificationTimeout%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.1",
    "eslint": "^9.23.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@types/minimatch": "^5.1.2",
    "java-parser": "^2.3.3",
    "minimatch": "^10.2.1"
  }
}
